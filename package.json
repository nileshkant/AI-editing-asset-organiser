{
  "name": "soundshelf-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "node scripts/desktop.mjs",
    "desktop:binary": "node scripts/desktop.mjs build --no-bundle",
    "desktop:bundle": "node scripts/release.mjs build",
    "check:rust": "node scripts/cargo.mjs test --workspace",
    "check": "npm test && npm run build && npm run check:rust",
    "mcp:bridge": "node scripts/cargo.mjs build -p soundshelf-agent --bin soundshelf-mcp --release --locked",
    "release:check": "node scripts/release.mjs check",
    "release:inspect": "node scripts/release.mjs inspect",
    "release:qualify": "node scripts/qualification.mjs",
    "media:build": "node scripts/media-build.mjs",
    "desktop:local": "node scripts/release.mjs local",
    "release:inspect-local": "node scripts/release.mjs inspect-local",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "openpgp": "6.3.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
