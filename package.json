{
  "name": "soundshelf-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "desktop": "node scripts/desktop.mjs",
    "desktop:binary": "node scripts/desktop.mjs build --no-bundle",
    "desktop:bundle": "node scripts/desktop.mjs build --config src-tauri/tauri.release.conf.json",
    "check:rust": "node scripts/cargo.mjs test --workspace",
    "check": "npm test && npm run build && npm run check:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
