{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundShelf", "version": "0.1.0", "identifier": "app.soundshelf.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "SoundShelf", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 560, "backgroundColor": "#111114" }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": [], "macOS": { "minimumSystemVersion": "14.2" } }
}
